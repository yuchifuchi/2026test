<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS 設定のひな形。part フォルダ・staff フォルダの直下に、
  それぞれ 1 つずつ置いてください。

  ==================================================================
  IIS マネージャーでの設定は要りません
  ==================================================================
  パート職員と正規職員は「アドレス（置き場所）」だけで分けています。

      http://<サーバー>/nippou/part/     受付入力・その他業務だけ
      http://<サーバー>/nippou/staff/    日報・帳票・集計・マスタ保守も

  part フォルダには職員用の画面ファイルそのものが入っていません。
  ですから、認証も IP 制限も設定しなくて構いません。
  （staff のアドレスを知っている人は開けます。課内で使う前提の作りです）

  ==================================================================
  この web.config に書いてはいけないもの
  ==================================================================
  IIS は既定で、次を web.config から変えることを禁じています。

      <asp>                                     … ASP の細かい設定
      <security><authentication>                … 匿名認証・Windows 認証
      <security><ipSecurity>                    … IP アドレス制限

  書くとサイト全体が
      HTTP 500.19 (構成データが無効です)
  になり、どのページも開けなくなります。ですからここには書いていません。
  あとで制限をかけたくなったときも、web.config ではなく
  IIS マネージャーの画面から設定してください。
-->
<configuration>
  <system.webServer>

    <defaultDocument>
      <files>
        <clear />
        <add value="default.asp" />
      </files>
    </defaultDocument>

    <security>
      <requestFiltering>
        <!-- データベース本体や設計ファイルをブラウザから取れないようにする -->
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".accdb" allowed="false" />
          <add fileExtension=".mdb"   allowed="false" />
          <add fileExtension=".laccdb" allowed="false" />
          <add fileExtension=".bas"   allowed="false" />
          <add fileExtension=".config" allowed="false" />
        </fileExtensions>
        <requestLimits maxAllowedContentLength="4194304" />
      </requestFiltering>
    </security>

    <!--
      ASP がエラーで止まったとき (500.100) は error.asp に回す。
      error.asp が Server.GetLastError() で中身を画面に出すので、
      IIS の「ASP → ブラウザーにエラーを送信する」を True にしなくても、
      止まった理由（ファイル名・行・内容）がそのまま読めます。

      ★ path は「サイトの先頭 / からの場所」です。
        nippou を既定の Web サイト直下に置いた場合は、このままで動きます。
        別の場所に置いた場合は、ここを実際の場所に直してください。
        (直さないと、エラーのときに何も出なくなります)
    -->
    <httpErrors errorMode="Custom" existingResponse="PassThrough">
      <remove statusCode="500" subStatusCode="100" />
      <error statusCode="500" subStatusCode="100"
             path="/nippou/part/error.asp" responseMode="ExecuteURL" />
    </httpErrors>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
    </staticContent>

  </system.webServer>
</configuration>
