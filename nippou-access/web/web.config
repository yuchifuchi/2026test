<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS 設定のひな形。web/ の中身と一緒に配置してください。

  この設定でやっていること
    ・Windows 認証を有効にし、匿名アクセスを止める（誰が入力したかを記録するため）
    ・既定のページを default.asp にする
    ・詳細なエラー内容を画面に出さない（サーバーの構成が外に漏れないように）
    ・.accdb や .bas などの中身をブラウザから直接ダウンロードできないようにする

  IIS マネージャーの GUI で同じ設定をしても構いません。
-->
<configuration>
  <system.webServer>

    <defaultDocument>
      <files>
        <clear />
        <add value="default.asp" />
      </files>
    </defaultDocument>

    <security>
      <authentication>
        <windowsAuthentication enabled="true" />
        <anonymousAuthentication enabled="false" />
      </authentication>

      <requestFiltering>
        <!-- データベース本体や設計ファイルをブラウザから取れないようにする -->
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".accdb" allowed="false" />
          <add fileExtension=".mdb"   allowed="false" />
          <add fileExtension=".laccdb" allowed="false" />
          <add fileExtension=".bas"   allowed="false" />
          <add fileExtension=".config" allowed="false" />
        </fileExtensions>
        <requestLimits maxAllowedContentLength="4194304" />
      </requestFiltering>
    </security>

    <asp scriptErrorSentToBrowser="false" bufferingOn="true">
      <session allowSessionState="true" timeout="00:60:00" />
      <limits scriptTimeout="00:01:30" />
    </asp>

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="500" />
      <error statusCode="500" path="/nippou/error.asp" responseMode="ExecuteURL" />
    </httpErrors>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
    </staticContent>

  </system.webServer>
</configuration>
