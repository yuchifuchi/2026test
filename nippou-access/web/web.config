<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS 設定のひな形。web/ の中身と一緒に、そのまま置いてください。

  ここには「既定のままでも上書きできる設定」だけを書いています。
  IIS は既定で、web.config から次の 2 つを変えることを禁じています。

      <asp>                                     … ASP の細かい設定
      <security><authentication>                … Windows 認証・匿名認証

  これらを web.config に書くと、サイト全体が
      HTTP 500.19 (構成データが無効です)
  になり、どのページも開けなくなります。ですからここには書きません。
  この 2 つは IIS マネージャーの画面から設定してください（手順は下）。

  ==================================================================
  IIS マネージャーで行う設定（1 回だけ）
  ==================================================================
  対象サイト（または nippou アプリケーション）を選び、

    1. 「認証」を開く
         Windows 認証 … 有効
         匿名認証      … 無効
       ※「Windows 認証」が一覧に無いときは、サーバー マネージャーで
         [Web サーバー] → [セキュリティ] → [Windows 認証] を追加します。

    2. 「ASP」を開く
         デバッグのプロパティ → ブラウザーにエラーを送信する
           設置作業のあいだは True（原因が画面に出ます）
           運用が始まったら False に戻してください
  ==================================================================
-->
<configuration>
  <system.webServer>

    <defaultDocument>
      <files>
        <clear />
        <add value="default.asp" />
      </files>
    </defaultDocument>

    <security>
      <requestFiltering>
        <!-- データベース本体や設計ファイルをブラウザから取れないようにする -->
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".accdb" allowed="false" />
          <add fileExtension=".mdb"   allowed="false" />
          <add fileExtension=".laccdb" allowed="false" />
          <add fileExtension=".bas"   allowed="false" />
          <add fileExtension=".config" allowed="false" />
        </fileExtensions>
        <requestLimits maxAllowedContentLength="4194304" />
      </requestFiltering>
    </security>

    <!--
      エラーの出しかた。
        DetailedLocalOnly = サーバー本体で開いたときだけ詳しく出し、
                            他のパソコンからは簡単な画面にする。
      設置作業はサーバーのブラウザで
        http://localhost/nippou/setup_check.asp
      を開くと、つまずいている箇所がそのまま読めます。
    -->
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
    </staticContent>

  </system.webServer>
</configuration>

<!--
  ==================================================================
  運用が始まったあと、エラー画面を自前のものに差し替えたいとき
  ==================================================================
  下を <system.webServer> の中に足します。path は「実際に置いた場所」に
  合わせてください（/nippou/ 以外に置いた場合はそこを直します）。
  この行を書き間違えると、エラーのときに何も出なくなります。

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="500" />
      <error statusCode="500" path="/nippou/error.asp" responseMode="ExecuteURL" />
    </httpErrors>
-->
