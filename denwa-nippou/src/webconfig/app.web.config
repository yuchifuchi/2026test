<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!--
      この web.config に書いてよいのは、IIS が最初から「フォルダごとに変えてよい」としている設定だけです。
      <asp>（ASP の設定）、<authentication>（認証）、<ipSecurity>（IP アドレスの制限）などを書くと、
      サイト全体が「HTTP エラー 500.19 構成データが無効です」になり、すべての画面が開けなくなります。
      それらが必要になったときは、IIS マネージャーの画面で設定します（手順書 03_困ったとき）。

      エラーのときは error.asp に「何が起きたか」を出させる。
      ・ASP の実行時エラーは 500 ではなく 500.100 なので、500.100 を拾う。
      ・existingResponse="PassThrough" にしないと、IIS が本文を捨てて既定の画面に差し替える。
    -->
    <httpErrors errorMode="Custom" existingResponse="PassThrough">
      <remove statusCode="500" subStatusCode="100" />
      <error statusCode="500" subStatusCode="100" path="/nippou/{{FOLDER}}/error.asp" responseMode="ExecuteURL" />
    </httpErrors>
    <defaultDocument>
      <files>
        <remove value="default.asp" />
        <add value="default.asp" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
